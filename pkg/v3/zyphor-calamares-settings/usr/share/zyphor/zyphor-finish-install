#!/bin/sh

set -e

echo "INFO: Finishing Zyphor OS installation..."

configure_apt_sources() {
    echo "INFO: Configuring Debian Trixie APT sources..."

    grep -qF 'deb https://deb.debian.org/debian trixie main contrib non-free non-free-firmware' /etc/apt/sources.list ||
        echo 'deb https://deb.debian.org/debian trixie main contrib non-free non-free-firmware' >> /etc/apt/sources.list

    grep -qF 'deb https://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware' /etc/apt/sources.list ||
        echo 'deb https://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware' >> /etc/apt/sources.list

    grep -qF 'deb https://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware' /etc/apt/sources.list ||
        echo 'deb https://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware' >> /etc/apt/sources.list
}

update_apt() {
    echo "INFO: Updating APT package lists..."

    apt-get update
}

install_zyphor_plymouth() {
    echo "INFO: Installing Zyphor Plymouth..."

    if dpkg -s zyphor-plymouth >/dev/null 2>&1; then
        echo "INFO: zyphor-plymouth is already installed."
        return 0
    fi

    echo "INFO: Installing zyphor-plymouth..."
    apt-get install -y zyphor-plymouth
}

configure_zyphor() {
    echo "INFO: Applying Zyphor OS configuration..."

    # Zyphor-specific configuration goes here.
    #
    # Wallpapers
    # XFCE configuration
    # GRUB
    # Zyphor branding
    # First boot
    # etc.
}

configure_apt_sources
update_apt
install_zyphor_plymouth
configure_zyphor

echo "INFO: Zyphor OS installation configuration complete."

exit 0